              "PORT": {
                "defaultValue": "4321",
                "description": "Private Node listener the gateway forwards to; Railway's health check calls /_emdash/api/health on it.",
                "isOptional": false
              }
            },
            "volumeMounts": {
              "ee481925-d936-4ace-bf6b-02bbc009432b": {
