              "healthcheckTimeout": 120,
              "numReplicas": 1,
              "restartPolicyMaxRetries": 10,
              "restartPolicyType": "ON_FAILURE",
              "startCommand": "/bin/sh -ec \"printf %s '' | base64 -d | gzip -dc >/tmp/gateway-start.sh; exec /bin/sh /tmp/gateway-start.sh\""
            },
            "icon": null,
            "name": "EmDash",
            "networking": {
              "serviceDomains": {
                "<hasDomain>": {
                  "port": 8080
                }
              },
              "tcpProxies": {}
            },
            "source": {
              "image": "caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0"
            },
            "variables": {
              "EMDASH_APP_ADDRESS": {
                "defaultValue": "${{EmDash App.RAILWAY_PRIVATE_DOMAIN}}:4321",
                "description": "Private address of the EmDash App service.",
                "isOptional": false
              },
              "GATEWAY_ADMIN_GATE": {
                "defaultValue": "admin",
                "description": "admin: the prompt guards the admin panel and setup. setup: only the setup API, which EmDash closes itself once setup is done; editors then sign in with passkeys alone.",
                "isOptional": false
              },
              "GATEWAY_PASSWORD": {
                "defaultValue": "${{secret(32, \"ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789\")}}",
                "description": "Generated password for the admin panel's browser prompt. Letters and digits, 16 or more. Share it only with people who edit the site.",
                "isOptional": false
              },
              "GATEWAY_TRUSTED_PROXIES": {
                "defaultValue": "100.64.0.0/10",
                "description": "Railway's edge range; the visitor address it reports is passed to EmDash for rate limits.",
                "isOptional": false
              },
              "GATEWAY_USERNAME": {
                "defaultValue": "admin",
                "description": "Username for the browser password prompt in front of the EmDash admin panel and first-run setup.",
                "isOptional": false
              },
              "PORT": {
                "defaultValue": "8080",
                "description": "Gateway listener; Railway's public domain and health check use it.",
                "isOptional": false
              }
            },
            "volumeMounts": {}
          },
          "ee481925-d936-4ace-bf6b-02bbc009432b": {
            "build": {
              "builder": "DOCKERFILE",
              "dockerfilePath": "Dockerfile",
              "watchPatterns": [
                "/Dockerfile",
                "/site/**",
                "/scripts/emdash-start.sh"
              ]
            },
            "deploy": {
              "healthcheckPath": "/_emdash/api/health",
              "healthcheckTimeout": 300,
              "numReplicas": 1,
              "restartPolicyMaxRetries": 10,
              "restartPolicyType": "ON_FAILURE",
              "startCommand": null
            },
            "icon": null,
            "name": "EmDash App",
            "networking": {
              "serviceDomains": {},
              "tcpProxies": {}
            },
            "source": {
              "branch": "release-v1",
              "repo": "tech-progress/railway-template-emdash",
              "rootDirectory": "/"
            },
            "variables": {
              "EMDASH_ENCRYPTION_KEY": {
                "defaultValue": "emdash_enc_v1_${{secret(42, \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\")}}A",
                "description": "Generated key that encrypts secret plugin settings. Keep a copy outside Railway; a database restored without it cannot read those settings.",
                "isOptional": false
              },
              "EMDASH_SITE_URL": {
                "defaultValue": "https://${{EmDash.RAILWAY_PUBLIC_DOMAIN}}",
                "description": "Public origin of the site. Passkeys, links and setup use it. Change it when you add a custom domain to the EmDash service, then redeploy.",
                "isOptional": false
              },
              "EMDASH_TRUSTED_PROXY_HEADERS": {
                "defaultValue": "x-real-ip",
