# Local Compose verification only (scripts/local-check.sh generates its own).
# Railway generates both values itself.
# 16 or more letters and digits.
GATEWAY_PASSWORD=changemechangemechangeme1
# emdash_enc_v1_ followed by 43 base64url characters that decode to 32 bytes
# (`npx emdash secrets generate` prints one).
EMDASH_ENCRYPTION_KEY=emdash_enc_v1_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# admin (default) or setup.
GATEWAY_ADMIN_GATE=admin
